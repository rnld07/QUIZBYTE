# Public Supabase project settings (safe to ship in the client – RLS protects the data).
# Never put the service role key or any ElevenLabs key in the mobile app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# development | staging | production (defaults to development)
EXPO_PUBLIC_APP_ENV=development
