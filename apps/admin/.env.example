# Public Supabase project settings (used in the browser and on the server).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets. NEVER prefix these with NEXT_PUBLIC_ and never commit real values.
# The service role key is only needed for server-side jobs (e.g. bulk import via API route).
SUPABASE_SERVICE_ROLE_KEY=

# ElevenLabs text-to-speech – only ever used server-side by the audio generation route.
# Leave empty to keep audio generation disabled.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
